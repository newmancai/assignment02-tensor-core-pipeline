new file mode 100644
index 0000000..b8eddcd
--- /dev/null
+++ b/flash_kda/dispatch.py
@@ -0,0 +1,204 @@
+"""Conservative, calibrated dispatch for FlashKDA Kernel 2 value slicing.
+
+The analytical features come from the K2 grid, recurrence length, duplicated
+TMA traffic, and compiled resource usage.  Latency coefficients are B300
+offline calibrations; unsupported devices and shapes deliberately use V128.
+"""
+
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+import math
+from typing import Mapping
+
+
+_DIMENSION = 128
+_CHUNK = 16
+_COMMON_TILE_BYTES = 13_888
+_B300_L2_BYTES = 132_644_864
+_MIN_RELATIVE_GAIN = 0.03
+_MIN_ABSOLUTE_GAIN_MS = 0.005
+
+
+@dataclass(frozen=True)
+class Variant:
+    value_slice: int
+    threads: int
+    registers_per_thread: int
+    shared_memory_bytes: int
+    intercept_ms: float
+    per_sequence_head_ms: float
+    extra_cta_layer_ms: float
+
+    @property
+    def slices(self) -> int:
+        return _DIMENSION // self.value_slice
+
+
+@dataclass(frozen=True)
+class DispatchDecision:
+    value_slice: int
+    reason: str
+    predicted_ms: Mapping[int, float]
+    resident_blocks_per_sm: Mapping[int, int]
+    reuse_footprint_bytes: int
+    reuse_over_l2: float
+
+    def as_dict(self) -> dict:
+        return asdict(self)
+
+
+# Fits exclude transition points and use independent-process medians.  Each
+# tuple is (tokens, per-variant intercept/per-x/extra-layer coefficients).
+_BF16_CALIBRATIONS = {
+    2048: {
+        16: (0.151090621, 0.000845711, 0.010853938),
+        32: (0.155862086, 0.000797256, 0.019375225),
+        64: (0.169650461, 0.000753838, 0.035217981),
+        128: (0.205233538, 0.000790399, 0.0),
+    },
+    4096: {
+        16: (0.279204257, 0.001661092, 0.017893640),
+        32: (0.288008119, 0.001543180, 0.036878412),
+        64: (0.315241212, 0.001443923, 0.071728845),
+        128: (0.386640773, 0.001500288, 0.0),
+    },
+    8192: {
+        16: (0.537473150, 0.003068970, 0.036876153),
+        32: (0.553008273, 0.002937679, 0.076584545),
+        64: (0.604635765, 0.002835139, 0.146840557),
+        128: (0.748772236, 0.002931072, 0.0),
+    },
+}
+
+_FP32_CALIBRATIONS = {
+    4096: {
+        16: (0.288545070, 0.001620028, 0.023031568),
+        32: (0.296811066, 0.001531913, 0.037417786),
+        64: (0.334322258, 0.001496270, 0.069331863),
+        128: (0.378462821, 0.001509650, 0.0),
+    },
+}
+
+_RESOURCES = {
+    16: (96, 54, 49_808),
+    32: (128, 58, 56_624),
+    64: (192, 58, 70_256),
+    128: (192, 73, 100_792),
+}
+
+
+def _fallback(reason: str, *, reuse_bytes: int = 0, l2_bytes: int = 0) -> DispatchDecision:
+    ratio = reuse_bytes / l2_bytes if l2_bytes else math.inf
+    return DispatchDecision(128, reason, {}, {}, reuse_bytes, ratio)
+
+
+def _interpolate_coefficients(tokens: int, state_fp32: bool) -> Mapping[int, tuple[float, float, float]] | None:
+    table = _FP32_CALIBRATIONS if state_fp32 else _BF16_CALIBRATIONS
+    if tokens in table:
+        return table[tokens]
+    points = sorted(table)
+    if tokens < points[0] or tokens > points[-1]:
+        return None
+    lower = max(point for point in points if point < tokens)
+    upper = min(point for point in points if point > tokens)
+    weight = (tokens - lower) / (upper - lower)
+    return {
+        value: tuple(
+            left + weight * (right - left)
+            for left, right in zip(table[lower][value], table[upper][value])
+        )
+        for value in _RESOURCES
+    }
+
+
+def _resident_blocks(resource: tuple[int, int, int], device: Mapping[str, int]) -> int:
+    threads, registers, shared_memory = resource
+    limits = (
+        int(device["shared_memory_per_sm"]) // shared_memory,
+        int(device["registers_per_sm"]) // (threads * registers),
+        int(device["max_threads_per_sm"]) // threads,
+        int(device["max_blocks_per_sm"]),
+    )
+    return max(0, min(limits))
+
+
+def select_k2_value_slice(
+    *,
+    batch: int,
+    tokens_per_sequence: int,
+    heads: int,
+    state_fp32: bool,
+    is_varlen: bool,
+    device: Mapping[str, int],
+) -> DispatchDecision:
+    """Score the calibrated candidates and return a guarded K2 selection."""
+
+    sequence_heads = batch * heads
+    tiles = math.ceil(tokens_per_sequence / _CHUNK)
+    reuse_bytes = sequence_heads * tiles * _COMMON_TILE_BYTES
+    l2_bytes = int(device.get("l2_bytes", 0))
+
+    if is_varlen:
+        return _fallback("varlen_not_calibrated", reuse_bytes=reuse_bytes, l2_bytes=l2_bytes)
+    if (int(device.get("major", -1)), int(device.get("minor", -1))) != (10, 3):
+        return _fallback("architecture_not_calibrated", reuse_bytes=reuse_bytes, l2_bytes=l2_bytes)
+    if int(device.get("sm_count", 0)) != 148:
+        return _fallback("sm_topology_not_calibrated", reuse_bytes=reuse_bytes, l2_bytes=l2_bytes)
+    if not (0.95 * _B300_L2_BYTES <= l2_bytes <= 1.05 * _B300_L2_BYTES):
+        return _fallback("l2_capacity_not_calibrated", reuse_bytes=reuse_bytes, l2_bytes=l2_bytes)
+    if not (1 <= sequence_heads <= 96):
+        return _fallback("sequence_head_domain_exceeded", reuse_bytes=reuse_bytes, l2_bytes=l2_bytes)
+
+    coefficients = _interpolate_coefficients(tokens_per_sequence, state_fp32)
+    if coefficients is None:
+        return _fallback("recurrence_length_not_calibrated", reuse_bytes=reuse_bytes, l2_bytes=l2_bytes)
+
+    sm_count = int(device["sm_count"])
+    residents = {
+        value: _resident_blocks(resource, device)
+        for value, resource in _RESOURCES.items()
+    }
+    scores: dict[int, float] = {}
+    for value, resource in _RESOURCES.items():
+        if residents[value] == 0:
+            continue
+        slices = _DIMENSION // value
+        grid = slices * sequence_heads
+        ctas_on_busiest_sm = math.ceil(grid / sm_count)
+
+        # The offline Phi calibration covers at most two CTA layers.  Rejecting
+        # extrapolation is intentional; those candidates are not needed by the
+        # validated high-value envelope.
+        if ctas_on_busiest_sm > 2:
+            continue
+        intercept, per_x, layer_step = coefficients[value]
+        scores[value] = (
+            intercept
+            + per_x * sequence_heads
+            + layer_step * max(0, ctas_on_busiest_sm - 1)
+        )
+
+    if 128 not in scores:
+        return _fallback("official_variant_not_feasible", reuse_bytes=reuse_bytes, l2_bytes=l2_bytes)
+
+    candidate = min(scores, key=scores.get)
+    official_ms = scores[128]
+    gain_ms = official_ms - scores[candidate]
+    relative_gain = gain_ms / official_ms
+    if candidate == 128:
+        reason = "official_predicted_fastest"
+    elif gain_ms < _MIN_ABSOLUTE_GAIN_MS or relative_gain < _MIN_RELATIVE_GAIN:
+        candidate = 128
+        reason = "gain_below_guard_band"
+    else:
+        reason = "calibrated_score_with_guard_band"
+
+    return DispatchDecision(
+        candidate,
+        reason,
+        scores,
+        residents,
+        reuse_bytes,
+        reuse_bytes / l2_bytes,
+    )

diff --git a/profile/k2-vsplit-opt/integrated_validation.py b/profile/k2-vsplit-opt/integrated_validation.py
new file mode 100644
index 0000000..de16b32
--- /dev/null
+++ b/profile/k2-vsplit-opt/integrated_validation.py
@@ -0,0 +1,213 @@
+"""Validate the single-extension K2 dispatcher on a CUDA device."""
+
+from __future__ import annotations
+
+import argparse
+import math
+import os
+import statistics
+import time
+
+import torch
+
+import flash_kda
+import flash_kda_C
+
+
+DIM = 128
+
+
+def make_inputs(batch: int, tokens: int, heads: int, dtype: torch.dtype, seed: int):
+    torch.manual_seed(seed)
+    shape = (batch, tokens, heads, DIM)
+    values = [torch.randn(shape, device="cuda", dtype=torch.bfloat16) for _ in range(4)]
+    beta = torch.randn(shape[:-1], device="cuda", dtype=torch.bfloat16)
+    a_log = torch.rand(heads, device="cuda", dtype=torch.float32)
+    dt_bias = torch.rand((heads, DIM), device="cuda", dtype=torch.float32)
+    state = torch.randn((batch, heads, DIM, DIM), device="cuda", dtype=dtype)
+    return (*values, beta, a_log, dt_bias, state)
+
+
+def raw_run(inputs, value_slice: int, cu_seqlens=None):
+    q, k, v, g, beta, a_log, dt_bias, state = inputs
+    sequences = state.shape[0]
+    workspace = torch.empty(
+        flash_kda_C.get_workspace_size(q.shape[0] * q.shape[1], q.shape[2], sequences),
+        device="cuda", dtype=torch.uint8,
+    )
+    out = torch.empty_like(v)
+    final_state = torch.empty_like(state)
+    flash_kda_C.fwd(
+        q, k, v, g, beta, 1.0 / math.sqrt(DIM), out, workspace,
+        a_log, dt_bias, -5.0, state, final_state, cu_seqlens, value_slice,
+    )
+    return out, final_state
+
+
+def validate_correctness():
+    for dtype in (torch.bfloat16, torch.float32):
+        inputs = make_inputs(1, 513, 3, dtype, 20260821)
+        reference = raw_run(inputs, 128)
+        for value in (16, 32, 64):
+            candidate = raw_run(inputs, value)
+            assert torch.equal(candidate[0], reference[0]), (dtype, value, "output")
+            assert torch.equal(candidate[1], reference[1]), (dtype, value, "state")
+
+    lengths = [31, 47, 19]
+    total = sum(lengths)
+    base = make_inputs(1, total, 3, torch.bfloat16, 20260822)
+    state = torch.randn((len(lengths), 3, DIM, DIM), device="cuda", dtype=torch.bfloat16)
+    inputs = (*base[:-1], state)
+    cu_seqlens = torch.tensor([0, 31, 78, 97], device="cuda", dtype=torch.int64)
+    reference = raw_run(inputs, 128, cu_seqlens)
+    for value in (16, 32, 64):
+        candidate = raw_run(inputs, value, cu_seqlens)
+        assert torch.equal(candidate[0], reference[0]), ("varlen", value, "output")
+        assert torch.equal(candidate[1], reference[1]), ("varlen", value, "state")
+    torch.cuda.synchronize()
+    print("correctness: fixed BF16/FP32 and ragged V16/V32/V64 bitwise equal to V128")
+
+
+def validate_policy():
+    expected = {18: 16, 19: 32, 37: 32, 38: 64, 74: 64, 75: 128}
+    for dtype in (torch.bfloat16, torch.float32):
+        for heads, value in expected.items():
+            q = torch.empty((1, 4096, heads, DIM), device="cuda", dtype=torch.bfloat16)
+            state = torch.empty((1, heads, DIM, DIM), device="cuda", dtype=dtype)
+            decision = flash_kda.explain_k2_dispatch(q, state, state)
+            assert decision["value_slice"] == value, (dtype, heads, decision)
+    print("policy: BF16/FP32 boundary decisions match the validated envelope")
+
+
+def event_median_ms(fn, warmup: int, iterations: int, graph: bool = False):
+    replay = fn
+    captured = None
+    if graph:
+        stream = torch.cuda.Stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            for _ in range(3):
+                fn()
+        torch.cuda.current_stream().wait_stream(stream)
+        torch.cuda.synchronize()
+        captured = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(captured):
+            fn()
+        replay = captured.replay
+    for _ in range(warmup):
+        replay()
+    torch.cuda.synchronize()
+    samples = []
+    for _ in range(iterations):
+        begin = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        begin.record()
+        replay()
+        end.record()
+        end.synchronize()
+        samples.append(begin.elapsed_time(end))
+    return statistics.median(samples)
+
+
+def make_package_runner(inputs):
+    q, k, v, g, beta, a_log, dt_bias, state = inputs
+    out = torch.empty_like(v)
+    final_state = torch.empty_like(state)
+
+    def run():
+        flash_kda.fwd(
+            q, k, v, g, beta, 1.0 / math.sqrt(DIM), out,
+            a_log, dt_bias, -5.0, state, final_state,
+        )
+
+    return run
+
+
+def validate_performance(warmup: int, iterations: int):
+    rows = []
+    for dtype_name, dtype in (("bf16", torch.bfloat16), ("fp32", torch.float32)):
+        for heads in (18, 19, 37, 38, 74, 75):
+            inputs = make_inputs(1, 4096, heads, dtype, 20260821 + heads)
+            run = make_package_runner(inputs)
+            os.environ["FLASH_KDA_K2_VALUE_SLICE"] = "128"
+            official = event_median_ms(run, warmup, iterations)
+            del os.environ["FLASH_KDA_K2_VALUE_SLICE"]
+            automatic = event_median_ms(run, warmup, iterations)
+            graph_auto = event_median_ms(run, warmup, iterations, graph=True)
+            decision = flash_kda.explain_k2_dispatch(inputs[0], inputs[-1], inputs[-1])
+            reduction = 100.0 * (1.0 - automatic / official)
+            rows.append((dtype_name, heads, decision["value_slice"], official, automatic, graph_auto, reduction))
+            if heads < 75:
+                assert automatic < official, rows[-1]
+    print("dtype,heads,slice,official_ms,auto_ms,graph_auto_ms,reduction_pct")
+    for row in rows:
+        print(f"{row[0]},{row[1]},{row[2]},{row[3]:.6f},{row[4]:.6f},{row[5]:.6f},{row[6]:.2f}")
+
+
+def validate_streaming_trace(warmup: int, iterations: int):
+    # Operator-level serving trace: one 4096-token stateful prefill followed by
+    # 64 one-token recurrent updates.  It is not a full model-serving result.
+    heads = 38
+    prefill_inputs = make_inputs(1, 4096, heads, torch.bfloat16, 20260830)
+    decode_inputs = make_inputs(1, 1, heads, torch.bfloat16, 20260831)
+    pq, pk, pv, pg, pbeta, pa_log, pdt_bias, pstate = prefill_inputs
+    dq, dk, dv, dg, dbeta, da_log, ddt_bias, _ = decode_inputs
+    pout = torch.empty_like(pv)
+    dout = torch.empty_like(dv)
+    states = [torch.empty_like(pstate), torch.empty_like(pstate)]
+
+    def trace():
+        flash_kda.fwd(
+            pq, pk, pv, pg, pbeta, 1.0 / math.sqrt(DIM), pout,
+            pa_log, pdt_bias, -5.0, pstate, states[0],
+        )
+        source = 0
+        for _ in range(64):
+            flash_kda.fwd(
+                dq, dk, dv, dg, dbeta, 1.0 / math.sqrt(DIM), dout,
+                da_log, ddt_bias, -5.0, states[source], states[1 - source],
+            )
+            source = 1 - source
+
+    samples_by_mode = {"official": [], "auto": []}
+    for mode in ("official", "auto", "auto", "official"):
+        if mode == "official":
+            os.environ["FLASH_KDA_K2_VALUE_SLICE"] = "128"
+        else:
+            os.environ.pop("FLASH_KDA_K2_VALUE_SLICE", None)
+        for _ in range(warmup):
+            trace()
+        torch.cuda.synchronize()
+        for _ in range(iterations):
+            torch.cuda.synchronize()
+            start = time.perf_counter()
+            trace()
+            torch.cuda.synchronize()
+            samples_by_mode[mode].append((time.perf_counter() - start) * 1000.0)
+    results = {
+        mode: statistics.median(samples)
+        for mode, samples in samples_by_mode.items()
+    }
+    reduction = 100.0 * (1.0 - results["auto"] / results["official"])
+    print(
+        f"streaming_trace prefill=4096 decode_steps=64 heads=38 "
+        f"official={results['official']:.6f} ms auto={results['auto']:.6f} ms "
+        f"reduction={reduction:.2f}%"
+    )
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--warmup", type=int, default=10)
+    parser.add_argument("--iterations", type=int, default=50)
+    args = parser.parse_args()
+    print(f"extension={flash_kda_C.__file__}")
+    print(f"device={flash_kda_C.get_device_characteristics()}")
+    validate_correctness()
+    validate_policy()
+    validate_performance(args.warmup, args.iterations)
+    validate_streaming_trace(max(2, args.warmup // 5), max(5, args.iterations // 5))
+
+
+if __name__ == "__main__":
+    main()

