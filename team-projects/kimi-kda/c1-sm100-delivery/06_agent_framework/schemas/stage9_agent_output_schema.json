{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["local_id", "hypothesis", "root_index", "nodes", "parent_policy_ids", "evidence_refs", "lineage_delta_refs"],
        "properties": {
          "local_id": {"type": "string", "minLength": 1, "maxLength": 80},
          "hypothesis": {"type": "string", "minLength": 1, "maxLength": 1000},
          "root_index": {"type": "integer", "minimum": 0, "maximum": 6},
          "nodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "feature", "cmp", "threshold", "cpc", "then_index", "else_index"],
              "properties": {
                "kind": {"type": "string", "enum": ["leaf", "branch"]},
                "feature": {"type": "string", "enum": ["none", "total_chunks", "max_chunks", "num_sequences", "resident_grid_capacity_ctas"]},
                "cmp": {"type": "string", "enum": ["none", "le", "gt"]},
                "threshold": {"type": "integer", "minimum": 0},
                "cpc": {"type": "integer", "enum": [0, 1, 2, 3, 4, 5, 6, 8, 9, 12, 16, 17, 18, 20, 24, 32]},
                "then_index": {"type": "integer", "minimum": -1, "maximum": 6},
                "else_index": {"type": "integer", "minimum": -1, "maximum": 6}
              }
            }
          },
          "parent_policy_ids": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "lineage_delta_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
